# =============================================================================
# SR Food API - PRODUCTION ENVIRONMENT (TEMPLATE ONLY)
# This file documents required environment variables for production.
# It contains NO real values. Real secrets are injected via CI/CD
# (GitHub Secrets / deployment pipeline) and this file is never used directly
# to source production credentials.
# =============================================================================

# --- App ---
NODE_ENV=production
PORT=4000
API_VERSION=v1

# --- Database ---
# MongoDB Atlas connection string (SRV format), TLS enabled by default.
MONGO_URI=

# --- JWT ---
# Must be cryptographically random strings, >= 64 characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- MSG91 (SMS — general notifications) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- Twilio Verify (SMS OTP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- SendGrid (Email) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Rail API (IRCTC/PNR provider) ---
RAIL_API_BASE_URL=
RAIL_API_KEY=

# --- CORS ---
# Comma-separated list of allowed production origins.
CORS_ALLOWED_ORIGINS=https://srfood.in,https://admin.srfood.in

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_AUTHENTICATED=500

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- Swagger ---
# Must be false in production per TRD 11.5.
SWAGGER_ENABLED=false
