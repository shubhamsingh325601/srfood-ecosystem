# =============================================================================
# SR Food API - PRODUCTION ENVIRONMENT (TEMPLATE ONLY)
# This file documents required environment variables for production.
# It contains NO real values. Real secrets are injected via CI/CD
# (GitHub Secrets / deployment pipeline) and this file is never used directly
# to source production credentials.
# =============================================================================

# --- App ---
# APP_ID selects which application this deployment serves.
# This drives branding, feature flags, database name, and email/SMS provider.
APP_ID=railbites
# APP_SECRET is a shared secret used internally for app validation (>= 32 chars).
APP_SECRET=

# Brand strings
APP_NAME=SRFOOD
APP_TAGLINE=Tasty Food, On Track
APP_DESCRIPTION=Order hygienic, fresh meals delivered to your train seat. Safar ka saath, swaad ke saath.
APP_OG_TITLE=SRFOOD – Tasty Food, On Track
APP_OG_DESCRIPTION=Order hygienic, fresh meals delivered to your train seat. Safar ka saath, swaad ke saath.

# Theme: orange | red
APP_THEME=orange

# Feature flags (true/false)
FEATURE_TRAINS=true
FEATURE_STATIONS=true
FEATURE_UPI_PAYMENTS=true
FEATURE_ADMIN_PRICING=false
FEATURE_FLOATING_CART_BAR=false
FEATURE_RESEND_EMAIL=false
FEATURE_SENDGRID_EMAIL=true
FEATURE_TWILIO_SMS=false
FEATURE_MSG91_SMS=true

NODE_ENV=production
PORT=4000
API_VERSION=v1

# --- Database ---
# MongoDB Atlas connection string (SRV format), TLS enabled by default.
# The database name is derived from APP_ID unless MONGO_DB_NAME is set explicitly.
MONGO_URI=
# Optional: override the auto-derived database name.
# MONGO_DB_NAME=

# --- JWT ---
# Must be cryptographically random strings, >= 64 characters each.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- MSG91 (SMS — general notifications) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- Twilio Verify (SMS OTP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- SendGrid (Email) ---
# Used when APP_ID=railbites
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Resend (Email) ---
# Used when APP_ID=shree-radhe-foods
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@shreeradhefood.in

# --- Admin ---
# Email alerts for new orders (used by shree-radhe-foods)
ADMIN_EMAIL=
# Frontend admin panel URL
ADMIN_PANEL_URL=

# --- Rail API (IRCTC/PNR provider) ---
# Used when APP_ID=railbites
RAIL_API_BASE_URL=
RAIL_API_KEY=

# --- CORS ---
# Comma-separated list of allowed production origins.
CORS_ALLOWED_ORIGINS=https://srfood.in,https://admin.srfood.in

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PUBLIC=100
RATE_LIMIT_MAX_AUTHENTICATED=500

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- Swagger ---
# Must be false in production per TRD 11.5.
SWAGGER_ENABLED=false
