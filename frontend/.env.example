# Backend API URL (required)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# App identifier (required)
VITE_APP_ID=railbites

# Brand strings (required)
VITE_APP_NAME=SRFOOD
VITE_APP_TAGLINE=Tasty Food, On Track
VITE_APP_DESCRIPTION=Order hygienic, fresh meals delivered to your train seat. Safar ka saath, swaad ke saath.
VITE_APP_OG_TITLE=SRFOOD – Tasty Food, On Track
VITE_APP_OG_DESCRIPTION=Order hygienic, fresh meals delivered to your train seat. Safar ka saath, swaad ke saath.

# Theme: orange | red
VITE_APP_THEME=orange

# Feature flags (true/false)
VITE_FEATURE_TRAINS=true
VITE_FEATURE_STATIONS=true
VITE_FEATURE_UPI_PAYMENTS=true
VITE_FEATURE_FLOATING_CART_BAR=false

