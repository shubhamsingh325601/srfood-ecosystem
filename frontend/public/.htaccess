# Serve index.html for any request that isn't a real file/folder, so the
# client-side router (TanStack Router) can handle routes like /admin, /menu, etc.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
